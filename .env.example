# Copy this file to .env and fill in what you need. rxiver runs FULLY with none of
# these set: no key -> MOCK AI mode, and ranking falls back to a zero-dependency
# lexical (BM25) scorer. Real arXiv search works with no key at all.

# --- AI (server-side only; never shipped to the browser) -------------------
# If unset, the server runs in MOCK MODE (fully usable, no key needed).
ANTHROPIC_API_KEY=

# --- Optional: semantic embeddings for "similar paper" ranking -------------
# If BOTH of these are set, rxiver ranks candidate papers with cosine
# similarity over embeddings from a generic HTTP embeddings endpoint. If either
# is missing, ranking falls back to the built-in lexical BM25 scorer.
#
# The endpoint must accept POST { "input": ["text a", "text b", ...] } and
# return { "data": [ { "embedding": [..] }, ... ] } (OpenAI-compatible shape).
# EMBEDDINGS_MODEL is optional and forwarded as { "model": "..." } if present.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# --- Corpus refresh (see README) -------------------------------------------
# Comma-separated arXiv categories the routine refresh fetches latest papers
# for. Used by `npm run refresh` and POST /api/refresh when no topics are given.
REFRESH_CATEGORIES=cs.LG,cs.AI,cs.CL

# Optional: override the server port (default 3001)
PORT=3001
